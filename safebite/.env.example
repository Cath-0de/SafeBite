# Copy to .env.local (gitignored) and fill in from the Firebase console:
# Project settings > General > Your apps > Web app > SDK config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check site key (public): classic reCAPTCHA v3 from google.com/recaptcha/admin > Site key.
# (Its secret key goes only in Firebase console > App Check, never here.)
# Optional; nothing requires App Check at the moment.
VITE_RECAPTCHA_SITE_KEY=

# Address of SafeBite's Cloudflare Worker (worker/), which holds the USDA and Groq
# keys. Not a secret. Without it, USDA lookups and the AI features are off. Locally: http://localhost:8787 while `npm run dev` runs in
# worker/. Deployed: the https://safebite-api.<you>.workers.dev URL wrangler prints.
VITE_API_URL=
