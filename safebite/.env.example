# Copy to .env.local (gitignored) and fill in from the Firebase console:
# Project settings > General > Your apps > Web app > SDK config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check site key (public): classic reCAPTCHA v3 from google.com/recaptcha/admin > Site key.
# (Its secret key goes only in Firebase console > App Check, never here.)
# Optional; without it Gemini calls (lib/ai.ts) aren't protected by App Check.
VITE_RECAPTCHA_SITE_KEY=
