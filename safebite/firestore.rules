rules_version = '2';

// The browser talks to Firestore directly, so these rules are the only thing
// protecting data. Any path not matched below is denied. Field shapes mirror
// src/lib/schema.ts, so keep the two in sync.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function optionalString(field, maxLen) {
      return !(field in incoming()) || (incoming()[field] is string && incoming()[field].size() <= maxLen);
    }

    function optionalList(field, maxLen) {
      return !(field in incoming()) || (incoming()[field] is list && incoming()[field].size() <= maxLen);
    }

    // ---- profiles/{uid} ----
    function validProfileFields() {
      return incoming().keys().hasOnly(['email', 'name', 'createdAt', 'allergens', 'hasUC', 'currentState', 'energyLevel', 'updatedAt'])
        && incoming().keys().hasAll(['email', 'name', 'createdAt', 'allergens', 'currentState', 'energyLevel', 'updatedAt'])
        && incoming().name is string && incoming().name.size() <= 100
        && incoming().allergens is list && incoming().allergens.size() <= 50
        && (!('hasUC' in incoming()) || incoming().hasUC is bool)
        && incoming().currentState in ['flare', 'remission']
        && incoming().energyLevel in ['low', 'medium', 'high']
        && incoming().updatedAt == request.time;
    }

    match /profiles/{uid} {
      allow read, delete: if isOwner(uid);

      allow create: if isOwner(uid)
        && validProfileFields()
        && incoming().email == request.auth.token.email
        && incoming().createdAt == request.time;

      allow update: if isOwner(uid)
        && validProfileFields()
        && incoming().email == resource.data.email
        && incoming().createdAt == resource.data.createdAt;

      // ---- profiles/{uid}/recent/{mealId} ----
      match /recent/{mealId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && incoming().keys().hasOnly(['name', 'thumbnail', 'viewedAt'])
          && incoming().keys().hasAll(['name', 'thumbnail', 'viewedAt'])
          && incoming().name is string && incoming().name.size() <= 300
          && incoming().thumbnail is string && incoming().thumbnail.size() <= 500
          && incoming().viewedAt == request.time;
      }

      // ---- profiles/{uid}/saved/{mealId} ----
      match /saved/{mealId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && incoming().keys().hasOnly(['name', 'thumbnail', 'savedAt'])
          && incoming().keys().hasAll(['name', 'thumbnail', 'savedAt'])
          && incoming().name is string && incoming().name.size() <= 300
          && incoming().thumbnail is string && incoming().thumbnail.size() <= 500
          && incoming().savedAt == request.time;
      }

      // ---- profiles/{uid}/logs/{logId} ----
      match /logs/{logId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && incoming().keys().hasOnly(['loggedAt', 'mealDescription', 'mealType', 'recipeId', 'recipeThumbnail', 'ingredients', 'symptomScore', 'notes'])
          && incoming().keys().hasAll(['loggedAt', 'mealDescription', 'symptomScore'])
          && incoming().loggedAt is timestamp
          && incoming().mealDescription is string
          && incoming().mealDescription.size() > 0 && incoming().mealDescription.size() <= 1000
          && incoming().symptomScore is number
          && incoming().symptomScore >= 0 && incoming().symptomScore <= 10
          && (!('mealType' in incoming()) || incoming().mealType in ['breakfast', 'lunch', 'dinner', 'snack'])
          && optionalString('recipeId', 40)
          && optionalString('recipeThumbnail', 500)
          && optionalList('ingredients', 100)
          && optionalString('notes', 2000);
      }

      // ---- profiles/{uid}/variants/{variantId} ----
      match /variants/{variantId} {
        function validVariantFields() {
          return incoming().keys().hasOnly(['baseRecipeId', 'baseRecipeName', 'swaps', 'createdAt'])
            && incoming().keys().hasAll(['baseRecipeId', 'baseRecipeName', 'swaps', 'createdAt'])
            && incoming().baseRecipeId is string
            && incoming().baseRecipeName is string && incoming().baseRecipeName.size() <= 300
            && incoming().swaps is list && incoming().swaps.size() <= 50;
        }

        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validVariantFields() && incoming().createdAt == request.time;
        allow update: if isOwner(uid) && validVariantFields() && incoming().createdAt == resource.data.createdAt;
      }

      // ---- profiles/{uid}/triggers/current ----
      // Written only by the ML pipeline via the Admin SDK (which bypasses rules).
      match /triggers/{docId} {
        allow read: if isOwner(uid) && docId == 'current';
        allow write: if false;
      }
    }

    // ---- products/{barcode} ----
    // Products users added when Open Food Facts lacked them. Any signed-in user
    // can read them and add a new one; only the person who added one can edit it.
    match /products/{barcode} {
      function validProduct() {
        return barcode.matches('^[0-9]{6,14}$')
          && incoming().keys().hasOnly(['name', 'brand', 'ingredientsText', 'addedBy', 'updatedAt'])
          && incoming().keys().hasAll(['name', 'brand', 'ingredientsText', 'addedBy', 'updatedAt'])
          && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 300
          && incoming().brand is string && incoming().brand.size() <= 200
          && incoming().ingredientsText is string && incoming().ingredientsText.size() > 0 && incoming().ingredientsText.size() <= 5000
          && incoming().addedBy == request.auth.uid
          && incoming().updatedAt == request.time;
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null && validProduct();
      allow update: if request.auth != null && validProduct() && resource.data.addedBy == request.auth.uid;
    }

    // ---- recipes/{recipeId} ----
    // Recipes users wrote. Private ones only the owner can read; shared ones any
    // signed-in user can. Only the owner can change or delete one.
    match /recipes/{recipeId} {
      function validRecipe() {
        return incoming().keys().hasOnly(['name', 'category', 'area', 'instructions', 'ingredients', 'tags', 'shared', 'ownerId', 'createdAt', 'updatedAt'])
          && incoming().keys().hasAll(['name', 'category', 'area', 'instructions', 'ingredients', 'tags', 'shared', 'ownerId', 'createdAt', 'updatedAt'])
          && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 200
          && incoming().category is string && incoming().category.size() <= 60
          && incoming().area is string && incoming().area.size() <= 60
          && incoming().instructions is string && incoming().instructions.size() > 0 && incoming().instructions.size() <= 20000
          && incoming().ingredients is list && incoming().ingredients.size() > 0 && incoming().ingredients.size() <= 50
          && incoming().tags is list && incoming().tags.size() <= 10
          && incoming().shared is bool
          && incoming().ownerId == request.auth.uid
          && incoming().updatedAt == request.time;
      }

      allow read: if request.auth != null && (resource.data.shared == true || resource.data.ownerId == request.auth.uid);
      allow create: if request.auth != null && validRecipe() && incoming().createdAt == request.time;
      allow update: if request.auth != null && validRecipe()
        && resource.data.ownerId == request.auth.uid
        && incoming().createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // ---- rules/{ruleId} ----
    // Shared curated reference data: any signed-in user can read, nobody writes
    // from the client. Seed/edit it from the Firebase console or an admin script.
    match /rules/{ruleId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
